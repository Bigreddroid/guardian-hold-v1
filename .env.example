# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Signs every verdict. Any long random string; Render generates one.
GUARDIAN_SIGNING_KEY=
# Set to dev to allow a placeholder signing key on local runs only
GUARDIAN_ENV=dev

# Optional, add at the end: Claude page review (console.anthropic.com). Without it an
# offline rule check runs and is labelled "not AI".
ANTHROPIC_API_KEY=

# Telegraph (Counterparty Desk). Confirm after Season II opens on Nov 1:
# Base Sepolia = 84532, Ethereum Sepolia = 11155111.
CHAIN_ID=11155111
NETWORK_LABEL=Sepolia testnet
TOKEN_ADDRESS=
PRICE_SOURCE=
TELEGRAPH_ENDPOINT=
# Testnet-only wallet. Never put a wallet holding real funds here.
TELEGRAPH_WALLET_KEY=
